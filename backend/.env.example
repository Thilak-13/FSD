PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/payverify

# In-Memory Database Fallback (opt-in)
# When true and NODE_ENV=development, falls back to an ephemeral in-memory MongoDB
# if the primary database connection fails. In production or when false, fails immediately.
USE_MEMORY_DB=false

# Generate a secure production key: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Demo Seeding Control
# Seeding is strictly opt-in and will only run if SEED_DEMO_DATA=true.
# When SEED_DEMO_DATA=true and NODE_ENV=production, a warning will be logged.
SEED_DEMO_DATA=false

# Initial Production Admin Bootstrap
# In production where demo data seeding is disabled, bootstrap your initial Admin user
# by configuring INITIAL_ADMIN_EMAIL, INITIAL_ADMIN_NAME, and INITIAL_ADMIN_PASSWORD and running:
#   node scripts/createAdmin.js
INITIAL_ADMIN_EMAIL=admin@payverify.local
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=change_this_in_production

# SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=testpassword
EMAIL_FROM=PayVerify Alerts <alerts@payverify.local>

# Reminder Cron (default: daily at 08:00 AM)
REMINDER_CRON_SCHEDULE=0 8 * * *
